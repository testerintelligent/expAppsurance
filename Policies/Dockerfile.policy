# ── Stage 1: Build ──────────────────────────────────────────
FROM node:20.17.0 AS builder

WORKDIR /app

# Install dependencies first (layer cache)
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Pass backend URL at build time (CRA bakes env vars into the bundle)
ARG REACT_APP_API_URL=http://localhost:5000
ENV REACT_APP_API_URL=$REACT_APP_API_URL
ARG REACT_APP_PRICING_URL=http://localhost:5001
ENV REACT_APP_PRICING_URL=$REACT_APP_PRICING_URL

# Build the React app
COPY . .
RUN npm run build

# ── Stage 2: Serve with nginx ────────────────────────────────
FROM nginx:stable-alpine

# Remove default nginx content
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets from builder stage (CRA outputs to /build)
COPY --from=builder /app/build /usr/share/nginx/html

# Custom nginx config (port 3001, SPA routing)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3001

CMD ["nginx", "-g", "daemon off;"]
