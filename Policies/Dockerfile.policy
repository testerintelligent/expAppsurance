# ── Stage 1: Build ──────────────────────────────────────────
FROM node:20.17.0 AS builder

WORKDIR /app

# Install dependencies first (layer cache)
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Build the React app
COPY . .
# Pick the env file for the build (production | development) and use it as the build-mode file.
# The bundler bakes REACT_APP_* vars into the bundle.
ARG APP_ENV=production
# RUN cp .env.${APP_ENV} .env.production
RUN if [ "$APP_ENV" != "production" ]; then cp ".env.${APP_ENV}" .env.production; fi

RUN npm run build

# ── Stage 2: Serve with nginx ────────────────────────────────
FROM nginx:stable-alpine

# Remove default nginx content
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets from builder stage (CRA outputs to /build)
COPY --from=builder /app/build /usr/share/nginx/html

# Custom nginx config (port 3001, SPA routing)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3001

CMD ["nginx", "-g", "daemon off;"]
