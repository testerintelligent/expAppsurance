# ── Stage 1: Build ──────────────────────────────────────────
FROM node:20.17.0 AS builder

WORKDIR /app

# Install dependencies first (layer cache)
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Pick env file by APP_ENV (development|production); .env.production.local overrides all other .env files at build time
ARG APP_ENV=production

# Build the React app
COPY . .
RUN cp .env.${APP_ENV} .env.production.local
RUN npm run build

# ── Stage 2: Serve with nginx ────────────────────────────────
FROM nginx:stable-alpine

# Remove default nginx content
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets from builder stage (CRA outputs to /build)
COPY --from=builder /app/build /usr/share/nginx/html

# Custom nginx config (port 3001, SPA routing)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3001

CMD ["nginx", "-g", "daemon off;"]
