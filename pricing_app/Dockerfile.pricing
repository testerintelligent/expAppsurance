# Build stage
FROM node:20 AS builder
WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Build app
COPY . .
# Pick the env file for the build (production | development) and use it as the build-mode file.
# The bundler bakes VITE_* vars into the bundle.
ARG APP_ENV=production
RUN cp .env.${APP_ENV} .env.production

RUN npm run build

# Production stage
FROM nginx:stable-alpine

# Remove default nginx content and copy build artifacts
RUN rm -rf /usr/share/nginx/html/*
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80 for the static server
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]